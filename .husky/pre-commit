# Runs on every `git commit`. Skip once with `git commit --no-verify`.
#
# Works with npm or with bun alone: npm when Node is installed, otherwise bun
# (also from ~/.bun when a Git client starts the hook without the shell PATH).
# Under bun, --bun runs the tools' `node` scripts with bun.

if command -v npx >/dev/null 2>&1; then
  x() { npx --no-install "$@"; }
  run() { npm run "$@"; }
else
  BUN_BIN="${BUN_INSTALL:-$HOME/.bun}/bin"
  [ -d "$BUN_BIN" ] && PATH="$BUN_BIN:$PATH"
  if ! command -v bun >/dev/null 2>&1; then
    echo "pre-commit: needs npm (Node) or bun on the PATH" >&2
    exit 1
  fi
  x() { bun x --bun "$@"; }
  run() { bun run --bun "$@"; }
fi

# ESLint and Prettier on the staged files only (config: "lint-staged" in package.json).
x lint-staged

# Type errors can come from files that were not staged (a changed type used
# elsewhere), so the package and the example are checked.
run typecheck
