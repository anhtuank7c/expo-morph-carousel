---
/**
 * The full source of a demo, read from the example app at build time, so
 * the code on the page is the code that runs in the phone. One tab per file.
 */
import { Code, TabItem, Tabs } from '@astrojs/starlight/components';

interface Props {
  /** Paths inside example/, for example `app/stories.tsx` or `data/demos.ts`. */
  files: string[];
}
const sources = import.meta.glob('../../../example/{app,data}/*.{ts,tsx}', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;
const repo = 'https://github.com/anhtuank7c/expo-morph-carousel/blob/main/example/';
const files = Astro.props.files.map((path) => {
  const code = sources[`../../../example/${path}`];
  if (code === undefined) throw new Error(`Source: example/${path} not found`);
  return { path, code };
});
const vi = Astro.currentLocale === 'vi';
---

{
  files.length === 1 ? (
    <Code code={files[0].code} lang="tsx" title={`example/${files[0].path}`} />
  ) : (
    <Tabs>
      {files.map((f) => (
        <TabItem label={f.path.split('/').pop()!}>
          <Code code={f.code} lang="tsx" title={`example/${f.path}`} />
        </TabItem>
      ))}
    </Tabs>
  )
}
<p class="source-links">
  {
    files.map((f) => (
      <a href={repo + f.path} target="_blank" rel="noopener">
        {vi ? 'Xem trên GitHub' : 'View on GitHub'}: {f.path}
      </a>
    ))
  }
</p>

<style>
  .source-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: var(--sl-text-sm);
  }
</style>
