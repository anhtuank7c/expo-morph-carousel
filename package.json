{
  "name": "expo-morph-carousel",
  "version": "0.2.0",
  "description": "Carousel for Expo where the images melt into each other like liquid while the pages slide. Skia + Reanimated 4, presets, loop, autoplay, vertical, accessibility, iOS / Android / web.",
  "homepage": "https://anhtuank7c.github.io/expo-morph-carousel/",
  "bugs": {
    "url": "https://github.com/anhtuank7c/expo-morph-carousel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anhtuank7c/expo-morph-carousel.git"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "workspaces": [
    "example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./test/resolve-ts.mjs --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "prepack": "npm run clean && npm run build",
    "example": "cd example && expo start",
    "prepare": "husky"
  },
  "keywords": [
    "react-native",
    "expo",
    "carousel",
    "slider",
    "pager",
    "morph",
    "liquid",
    "gooey",
    "skia",
    "reanimated",
    "onboarding",
    "web"
  ],
  "author": "Tuan Nguyen",
  "license": "MIT",
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "expo-file-system": ">=58.0.0"
  },
  "peerDependenciesMeta": {
    "@shopify/react-native-skia": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@shopify/react-native-skia": "2.14.0",
    "@types/react": "~19.3.3",
    "babel-preset-expo": "~58.0.27",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "expo": "~58.0.26",
    "expo-file-system": "~58.0.15",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,yaml,yml,html,css}": "prettier --write --ignore-unknown"
  }
}
