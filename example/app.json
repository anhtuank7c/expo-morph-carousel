{
  "expo": {
    "name": "Morph Carousel",
    "slug": "morph-carousel",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "morphcarousel",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.example.morphcarousel"
    },
    "android": {
      "package": "dev.example.morphcarousel"
    },
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router"],
    "extra": {
      "supportsRTL": true
    }
  }
}
